{
    "name": "braskai/rask-sdk",
    "description": "PHP SDK for the Rask API v3 (video and audio localization).",
    "type": "library",
    "version": "3.0.0-alpha.0",
    "keywords": ["rask", "dubbing", "localization", "translation", "api", "sdk"],
    "homepage": "https://docs.api.rask.ai",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.9",
        "guzzlehttp/psr7": "^2.7",
        "psr/http-client": "^1.0",
        "psr/http-message": "^2.0",
        "psr/log": "^2.0 || ^3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "ext-curl": "Guzzle's curl handler: sub-second timeouts and connection reuse across retries."
    },
    "autoload": {
        "psr-4": {
            "Rask\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rask\\Sdk\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "generate": "php tools/generate.php",
        "generate:check": "php tools/generate.php --check",
        "lint": ["@generate:check", "phpstan analyse --no-progress --memory-limit=2G"],
        "test": "phpunit"
    }
}
